# AgroSentinel AI — Environment Configuration Template
# Copy this file to .env and fill in values

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="AgroSentinel AI"
APP_ENV=development
DEBUG=true

# ── Security (CHANGE IN PRODUCTION!) ──────────────────────────────────────────
JWT_SECRET_KEY=agrosentinel-dev-secret-change-in-production-abc123

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed for local development)
DATABASE_URL=sqlite:///./agrosentinel.db

# PostgreSQL (optional, for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/agrosentinel

# ── ML Models ─────────────────────────────────────────────────────────────────
# Vision Model checkpoint (auto-trained if missing)
VISION_MODEL_CHECKPOINT=models/checkpoints/vision_model.pt

# Fusion Model checkpoint (auto-generated heuristic if missing)
FUSION_MODEL_CHECKPOINT=models/checkpoints/fusion_model.pt

# Weather Model checkpoint (auto-generated XGBoost if missing)
WEATHER_MODEL_CHECKPOINT=models/checkpoints/weather_model.pkl

# ── External APIs (Optional - system works without these) ─────────────────────
# OpenWeatherMap API Key (for real weather data)
OPENWEATHERMAP_API_KEY=

# NASA EarthData for satellite imagery
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Twilio for SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Upload Limits ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
IMAGE_UPLOAD_DIR=data/uploads

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo Configuration ─────────────────────────────────────────────────────────
# Set to true to pre-populate database with synthetic demo data on startup
LOAD_DEMO_DATA=true
DEMO_REGION=Nashik
